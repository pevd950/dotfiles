# shellcheck shell=bash
# Resolve this project's environment once when entering the directory.
# Replace PROJECT, install direnv and its shell hook, then approve this file.
# Never enable xtrace while handling the bootstrap token or resolved values.
set +x

if ! has op || ! has python3; then
  log_error "Project secrets require 1Password CLI and Python 3."
  return 1
fi
if [ ! -f .env.op ]; then
  log_error "Project reference file .env.op is missing."
  return 1
fi

op_token_file="$HOME/.config/op/sa/PROJECT-local.token"
watch_file .env.op "$op_token_file"
if [ ! -f "$op_token_file" ]; then
  log_error "Project service-account token is missing; complete project setup."
  return 1
fi
if stat --version >/dev/null 2>&1; then
  op_token_mode="$(stat -c '%a' "$op_token_file")"
else
  op_token_mode="$(stat -f '%Lp' "$op_token_file")"
fi
if [ "$op_token_mode" != 600 ]; then
  log_error "Project service-account token must have mode 0600."
  return 1
fi
OP_SERVICE_ACCOUNT_TOKEN="$(cat "$op_token_file")" || return 1
if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
  log_error "Project service-account token is empty."
  return 1
fi
export OP_SERVICE_ACCOUNT_TOKEN

# Capture shell-quoted exports in memory. Masking must be off for this private
# handoff; nothing is printed or saved as a plaintext environment/dump file.
# Partial output from a failed lookup is never evaluated.
if ! op_environment="$(op run --no-masking --env-file .env.op -- python3 -c '
import os, re, shlex
reserved = {"BASHOPTS", "SHELLOPTS", "UID", "EUID", "PPID", "SHLVL", "_"}
for name, value in sorted(os.environ.items()):
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name) and not name.startswith("DIRENV_") and name not in reserved:
        print("export " + name + "=" + shlex.quote(value))
' 2>/dev/null)"; then
  log_error "Unable to load project secrets; check the service-account expiry and network."
  return 1
fi
eval "$op_environment"
unset op_environment op_token_file op_token_mode
