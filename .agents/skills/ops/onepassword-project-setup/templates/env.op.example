# .env.op: the project's environment with op:// references for secrets and literals for config.
# Copy to the repo root as .env.op (scripts/build-env-op.py generates one from an existing .env),
# then run every command that needs it through `op run --env-file .env.op -- <command>`
# (templates/op-run.sh), which resolves the references with the local service-account token.
# build-env-op.py adds .env.op and .envrc to .git/info/exclude; references are not secrets, but the
# file is per-developer, so it stays untracked.
#
# Reference shape: op://<Vault>/<Item title>/<field>. Item titles must not contain `·`, `/` or
# parentheses (reference them by item ID instead). Items are tagged project:<slug>,
# env:<dev|ci|staging|local|prod|runtime> and consumer:<local|ci|release|runtime>.
# Replace PROJECT with the project name used in the vault and item titles.

# --- secrets: op:// references into the project's Dev vault -----------------------------------
OPENAI_API_KEY=op://PROJECT Dev/OpenAI PROJECT-dev/credential
ANTHROPIC_API_KEY=op://PROJECT Dev/Anthropic PROJECT-dev/credential
DATABASE_URL=op://PROJECT Dev/Postgres PROJECT-local/url
SENTRY_DSN=op://PROJECT Dev/Sentry PROJECT-dev/dsn
# Cross-project keys agents use live in the shared vault the local service account can read:
POKE_API_KEY=op://Agent Tools Dev/Poke/credential

# --- config: plain literals, no secret value ---------------------------------------------------
APP_ENV=local
LOG_LEVEL=debug
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
