# plato-ai release dispatch config (no secrets here)
REPO="pevd950/plato-ai"
WORKFLOW_FILE="deploy-aca.yml"
DEFAULT_REF="main"
OP_APP_ITEM="op://Plato AI Prod/GitHub App plato-release-agent"
GATE_VAR="ALLOW_PRODUCTION_DEPLOY"
ENV_INPUT="environment"
TAG_INPUT="image-tag"
PROD_ENV_NAME="production"
# Workflow that builds images on main; its head sha gives the production image tag (sha-<7>).
BUILD_WORKFLOW_FILE="build-and-push.yml"
