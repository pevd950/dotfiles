#!/usr/bin/env zsh
set -euo pipefail

status() {
  printf "%-36s %s\n" "$1" "$2"
}

display_path() {
  local path="$1"
  if [[ -n "$path" ]]; then
    print -r -- "${path//$HOME/~}"
  else
    print -r -- "missing"
  fi
}

truthy() {
  [[ "${1:-}" == "1" || "${1:-}" == "true" || "${1:-}" == "yes" ]]
}

on_macos() {
  [[ "$(uname)" == "Darwin" ]]
}

ssh_config_file() {
  local ssh_config="$HOME/.ssh/config"

  if [[ -L "$ssh_config" && -e "$ssh_config" ]]; then
    print -r -- "${ssh_config:A}"
  else
    print -r -- "$ssh_config"
  fi
}

ensure_op_plugins_file() {
  local plugin_file="$HOME/.config/op/plugins.sh"

  mkdir -p "$(dirname "$plugin_file")"
  if [[ ! -e "$plugin_file" ]]; then
    printf "export OP_PLUGIN_ALIASES_SOURCED=1\n" > "$plugin_file"
    status "op plugins.sh" "created without global aliases"
  else
    status "op plugins.sh" "present"
  fi
}

ensure_codex_mcp() {
  local mcp_bin="/Applications/1Password.app/Contents/MacOS/onepassword-mcp"

  if ! command -v codex >/dev/null 2>&1; then
    status "codex mcp:1password" "skipped; codex missing"
    return 0
  fi

  if [[ ! -x "$mcp_bin" ]]; then
    status "codex mcp:1password" "skipped; onepassword-mcp missing"
    return 0
  fi

  if codex mcp list 2>/dev/null | awk 'BEGIN{found=0} /^1password[[:space:]]/ {found=1} END{exit found ? 0 : 1}'; then
    status "codex mcp:1password" "configured"
    return 0
  fi

  if codex mcp add 1password -- "$mcp_bin"; then
    status "codex mcp:1password" "added"
  else
    status "codex mcp:1password" "failed to add"
  fi
}

remove_legacy_1password_identity_agent() {
  local ssh_config="$1"
  local tmp_file
  local rc

  [[ -e "$ssh_config" ]] || return 1

  tmp_file="$(mktemp)" || return 1
  set +e
  awk '
    /^[[:space:]]*IdentityAgent[[:space:]]+"?~\/Library\/Group Containers\/2BUA8C4S2C\.com\.1password\/t\/agent\.sock"?[[:space:]]*$/ {
      removed=1
      next
    }
    /^[[:space:]]*IdentityAgent[[:space:]]+"?\/Users\/[^"]+\/Library\/Group Containers\/2BUA8C4S2C\.com\.1password\/t\/agent\.sock"?[[:space:]]*$/ {
      removed=1
      next
    }
    { print }
    END { exit removed ? 0 : 2 }
  ' "$ssh_config" > "$tmp_file"
  rc=$?
  set -e

  if [[ "$rc" -eq 0 ]]; then
    if cmp -s "$ssh_config" "$tmp_file"; then
      rm -f "$tmp_file"
      return 1
    fi
    mv "$tmp_file" "$ssh_config"
    chmod 600 "$ssh_config"
    return 0
  fi

  rm -f "$tmp_file"
  return 1
}

ensure_ssh_config_identity_agent() {
  local ssh_dir="$HOME/.ssh"
  local ssh_config_path="$ssh_dir/config"
  local ssh_config
  local include_dir="$ssh_dir/config.d"
  local include_file="$include_dir/1password-agent.conf"
  local include_line='Include ~/.ssh/config.d/1password-agent.conf'
  local agent_path='~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'
  local agent_socket="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  local tmp_file
  local cleaned=0
  local remove_generated_file=0
  local remove_managed_include=0

  ssh_config="$(ssh_config_file)"

  if remove_legacy_1password_identity_agent "$ssh_config"; then
    status "ssh config legacy IdentityAgent" "removed"
  fi

  if [[ ! -S "$agent_socket" ]]; then
    if [[ -f "$include_file" ]] && grep -q '^# Generated by dotfiles scripts/setup-1password-dev\.zsh\.$' "$include_file"; then
      remove_generated_file=1
      remove_managed_include=1
    elif [[ ! -e "$include_file" ]]; then
      remove_managed_include=1
    fi

    if [[ -e "$ssh_config" && "$remove_managed_include" -eq 1 ]]; then
      tmp_file="$(mktemp)" || {
        status "ssh config include" "skipped; temp file unavailable for stale include cleanup"
        return 0
      }
      awk '
        /^[[:space:]]*Include[[:space:]]+.*\.ssh\/config\.d\/1password-agent\.conf[[:space:]]*$/ { next }
        /^# >>> dotfiles 1Password SSH agent$/ { skip=1; next }
        /^# <<< dotfiles 1Password SSH agent$/ { skip=0; next }
        skip { next }
        { print }
      ' "$ssh_config" > "$tmp_file"
      if cmp -s "$ssh_config" "$tmp_file"; then
        rm -f "$tmp_file"
      else
        mv "$tmp_file" "$ssh_config"
        chmod 600 "$ssh_config"
        cleaned=1
      fi
    fi

    if [[ "$remove_generated_file" -eq 1 ]]; then
      rm -f "$include_file"
      cleaned=1
    fi

    if [[ "$cleaned" -eq 1 ]]; then
      status "ssh config include" "removed stale config; socket missing"
    else
      status "ssh config include" "skipped; 1Password SSH agent socket missing"
    fi
    return 0
  fi

  mkdir -p "$ssh_dir" "$include_dir"
  chmod 700 "$ssh_dir"

  {
    printf "# Generated by dotfiles scripts/setup-1password-dev.zsh.\n"
    printf "# Keep this include before other Host or Match blocks in ~/.ssh/config.\n"
    printf "# Use the GUI-backed 1Password SSH agent only for local sessions.\n"
    printf "# Inbound SSH sessions are unattended; let forwarded agents or host-specific SSH config handle them.\n"
    printf '%s\n' 'Match exec "test x${SSH_CONNECTION}${SSH_CLIENT} = x"'
    printf "  IdentityAgent \"%s\"\n" "$agent_path"
    printf "Match all\n"
  } > "$include_file"
  chmod 600 "$include_file"

  if [[ ! -e "$ssh_config" ]]; then
    printf "%s\n" "$include_line" > "$ssh_config_path"
    chmod 600 "$ssh_config_path"
    status "ssh config include" "created"
    return 0
  fi

  if awk '
    /^# >>> dotfiles 1Password SSH agent$/ { marker=1 }
    /^[[:space:]]*Include[[:space:]]+~\/\.ssh\/config\.d\/1password-agent\.conf[[:space:]]*$/ { include_seen=1 }
    /^[[:space:]]*Include[[:space:]]+~\/\.ssh\/config\.d\/\*\.conf[[:space:]]*$/ && !include_seen { block_before_include=1 }
    /^[[:space:]]*(Host|Match)[[:space:]]+/ && !include_seen { block_before_include=1 }
    END { exit (include_seen && !marker && !block_before_include) ? 0 : 1 }
  ' "$ssh_config"; then
    status "ssh config include" "present before SSH blocks"
    return 0
  fi

  tmp_file="$(mktemp)" || {
    status "ssh config include" "skipped; mktemp failed"
    return 0
  }
  awk -v include_line="$include_line" '
    function emit_include() {
      if (!emitted) {
        print include_line
        print ""
        emitted = 1
      }
    }
    /^[[:space:]]*Include[[:space:]]+.*\.ssh\/config\.d\/1password-agent\.conf[[:space:]]*$/ { next }
    /^# >>> dotfiles 1Password SSH agent$/ { skip=1; next }
    /^# <<< dotfiles 1Password SSH agent$/ { skip=0; next }
    skip { next }
    /^[[:space:]]*Include[[:space:]]+~\/\.ssh\/config\.d\/\*\.conf[[:space:]]*$/ { emit_include() }
    /^[[:space:]]*(Host|Match)[[:space:]]+/ { emit_include() }
    { print }
    END { emit_include() }
  ' "$ssh_config" > "$tmp_file"
  if cmp -s "$ssh_config" "$tmp_file"; then
    rm -f "$tmp_file"
    status "ssh config include" "present before SSH blocks"
  else
    mv "$tmp_file" "$ssh_config"
    status "ssh config include" "ensured before SSH blocks"
  fi

  chmod 600 "$ssh_config"
}

ssh_agent_has_keys() {
  local agent_socket="$1"
  local key_count

  [[ -n "$agent_socket" && -S "$agent_socket" ]] || return 1
  SSH_AUTH_SOCK="$agent_socket" ssh-add -l >/dev/null 2>&1 || return 1
  key_count="$(SSH_AUTH_SOCK="$agent_socket" ssh-add -l 2>/dev/null | wc -l | tr -d ' ')"
  [[ "${key_count:-0}" -gt 0 ]]
}

github_ssh_auth_ready() {
  local configured_agent=""
  local ssh_config

  ssh_config="$(ssh_config_file)"

  if command -v ssh >/dev/null 2>&1 && [[ -f "$ssh_config" ]]; then
    configured_agent="$(ssh -F "$ssh_config" -G github.com 2>/dev/null | awk 'tolower($1) == "identityagent" { $1=""; sub(/^[[:space:]]+/, ""); print; exit }' || true)"
  fi

  case "$configured_agent" in
    "")
      ssh_agent_has_keys "${SSH_AUTH_SOCK:-}"
      ;;
    "none")
      return 1
      ;;
    "SSH_AUTH_SOCK")
      ssh_agent_has_keys "${SSH_AUTH_SOCK:-}"
      ;;
    "~/"*)
      ssh_agent_has_keys "$HOME/${configured_agent#"~/"}"
      ;;
    *)
      ssh_agent_has_keys "$configured_agent"
      ;;
  esac
}

github_ssh_login_ready() {
  local ssh_config
  local output
  local rc

  ssh_config="$(ssh_config_file)"
  [[ -f "$ssh_config" ]] || return 1

  set +e
  output="$(ssh -F "$ssh_config" -o BatchMode=yes -o NumberOfPasswordPrompts=0 -o ConnectTimeout=5 -T git@github.com 2>&1)"
  rc=$?
  set -e

  [[ "$rc" -eq 1 && "$output" == *"successfully authenticated"* ]]
}

ensure_gh_ssh_protocol() {
  if ! command -v gh >/dev/null 2>&1; then
    status "gh git_protocol" "skipped; gh missing"
    return 0
  fi

  if ! github_ssh_auth_ready || ! github_ssh_login_ready; then
    status "gh git_protocol" "skipped; SSH auth unavailable"
    return 0
  fi

  if [[ "$(gh config get git_protocol -h github.com 2>/dev/null || true)" == "ssh" ]]; then
    status "gh git_protocol" "ssh"
    return 0
  fi

  if gh config set git_protocol ssh -h github.com >/dev/null 2>&1; then
    status "gh git_protocol" "set to ssh"
  else
    status "gh git_protocol" "failed to set"
  fi
}

write_agent_toml_from_1password() {
  # Writes ~/.config/1Password/ssh/agent.toml with ONE vault-level entry so the 1Password SSH agent
  # offers every SSH Key item in that vault. Item IDs change when items are moved between vaults,
  # which left the old per-item list pointing at nothing (found 2026-10-27); a vault entry never goes stale.
  # Per-host key selection comes from 1Password SSH bookmarks (generated ~/.ssh/1Password/config) or
  # IdentityFile stubs in ~/.ssh/config.d; the agent entry only decides which keys exist.
  local agent_config="$HOME/.config/1Password/ssh/agent.toml"
  local vault_name="${ONEPASSWORD_SSH_KEY_VAULT:-Servers}"
  local should_refresh=0
  local vault_id

  if truthy "${ONEPASSWORD_REFRESH_SSH_KEYS:-0}"; then
    should_refresh=1
  elif [[ ! -e "$agent_config" && -t 0 && -t 1 ]]; then
    should_refresh=1
  fi

  if [[ "$should_refresh" -ne 1 ]]; then
    if [[ -e "$agent_config" ]]; then
      status "agent.toml" "present; not refreshed"
    else
      status "agent.toml" "missing; rerun with ONEPASSWORD_REFRESH_SSH_KEYS=1"
    fi
    return 0
  fi

  if ! command -v op >/dev/null 2>&1; then
    status "agent.toml" "skipped; op missing"
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    status "agent.toml" "skipped; jq missing"
    return 0
  fi

  vault_id="$(op vault list --format json 2>/dev/null </dev/null \
    | jq -r --arg n "$vault_name" '.[] | select(.name == $n) | .id' | head -n1)"
  if [[ -z "$vault_id" ]]; then
    status "agent.toml" "skipped; vault '$vault_name' not found (set ONEPASSWORD_SSH_KEY_VAULT)"
    return 0
  fi

  mkdir -p "$(dirname "$agent_config")"
  {
    printf "# Generated by dotfiles scripts/setup-1password-dev.zsh.\n"
    printf "# One vault-level entry: every SSH Key item in the '%s' vault is offered by the 1Password SSH agent.\n" "$vault_name"
    printf "# Item IDs are not listed on purpose; they change when items move between vaults.\n"
    printf "# Pick keys per host with 1Password SSH bookmarks or IdentityFile + IdentitiesOnly in ~/.ssh/config.d.\n\n"
    printf "[[ssh-keys]]\nvault = %s\n" "$(printf '%s' "$vault_id" | jq -R .)"
  } > "$agent_config"
  chmod 600 "$agent_config"
  status "agent.toml" "wrote vault-level entry for '$vault_name'"
}

main() {
  if ! on_macos; then
    status "1Password dev setup" "skipped; not macOS"
    return 0
  fi

  status "1Password.app" "$([[ -d /Applications/1Password.app ]] && printf present || printf missing)"
  status "op" "$(display_path "$(command -v op 2>/dev/null || true)")"
  status "onepassword-mcp" "$([[ -x /Applications/1Password.app/Contents/MacOS/onepassword-mcp ]] && printf present || printf missing)"

  ensure_op_plugins_file
  ensure_codex_mcp
  ensure_ssh_config_identity_agent
  write_agent_toml_from_1password
  ensure_gh_ssh_protocol
  status "read-only preflight" "~/.config/zsh/custom/bin/onepassword-dev-preflight"
}

main "$@"
